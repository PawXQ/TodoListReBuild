<UserControl
    x:Class="TodoListReBuild.UserControls.TaskControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="5" Orientation="Horizontal">
            <Label Content="{Binding Content}" Visibility="{Binding LabelVisibility}" />
            <TextBox Text="{Binding Content}" Visibility="{Binding TextBoxVisibility}" />
            <Button
                Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}"
                Content="Delete" />
            <Button
                Command="{Binding DataContext.ModifyTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}"
                Content="Modify"
                Visibility="{Binding ModifyButVisibility}" />
            <Button
                Command="{Binding DataContext.SaveTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}"
                Content="Save"
                Visibility="{Binding SaveButVisibility}" />
            <Button
                Command="{Binding DetailCommand}"
                CommandParameter="{Binding}"
                Content="Detail" />

        </StackPanel>
    </Grid>
</UserControl>
